# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# Supabase > Connect > Session pooler (IPv4) เช่น
# postgresql://postgres.xxxx:รหัส@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/itshop?sslmode=disable
# สุ่มยาว ๆ อย่างน้อย 32 ตัว เช่น openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# URL หน้าเว็บที่อนุญาตให้เรียก API คั่นด้วย , (ตอน deploy ใส่ URL ของ Vercel)
ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
